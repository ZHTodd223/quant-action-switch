+def generate_completions_hf(
+    model,
+    tokenizer,
+    prompts: list[str],
+    max_new_tokens: int,
+    batch_size: int,
+) -> list[str]:
+    """Generate decoder-only completions in padded batches."""
+    if batch_size < 1:
+        raise ValueError(f"batch_size must be positive, got {batch_size}")
+
+    outputs: list[str] = []
+    original_padding_side = tokenizer.padding_side
+    tokenizer.padding_side = "left"
+    try:
+        for start in tqdm(
+            range(0, len(prompts), batch_size),
+            total=(len(prompts) + batch_size - 1) // batch_size,
+            desc="Running batched HF inference",
+        ):
+            batch_prompts = prompts[start : start + batch_size]
+            inputs = tokenizer(
+                batch_prompts,
+                return_tensors="pt",
+                padding=True,
+            ).to(get_model_device(model))
+            input_width = inputs["input_ids"].shape[1]
+            with torch.inference_mode():
+                generated = model.generate(
+                    **inputs,
+                    max_new_tokens=max_new_tokens,
+                    do_sample=False,
+                    pad_token_id=tokenizer.pad_token_id,
+                )
+            outputs.extend(
+                tokenizer.batch_decode(
+                    generated[:, input_width:],
+                    skip_special_tokens=True,
+                )
+            )
+    finally:
+        tokenizer.padding_side = original_padding_side
+    return [text.strip() for text in outputs]
+
+

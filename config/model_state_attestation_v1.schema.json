{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model_state_attestation_v1.schema.json",
  "title": "Runtime model-state attestation v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "model_id",
    "model_family",
    "protocol_id",
    "requested_state",
    "observed_state",
    "resolved_identity",
    "runtime",
    "parameters",
    "buffers",
    "devices",
    "modules",
    "bf16_policy",
    "bf16_observation",
    "quantization",
    "attestation"
  ],
  "properties": {
    "schema_version": {"const": "model_state_attestation_v1"},
    "run_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "model_family": {"type": "string", "minLength": 1},
    "protocol_id": {"type": "string", "minLength": 1},
    "attestation_requirements": {
      "type": "object",
      "properties": {
        "requirements_path": {"type": "string"},
        "requirements_version": {"type": "string"},
        "requirements_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "required_target_module_coverage": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 1.0
        }
      }
    },
    "requested_state": {
      "type": "object",
      "required": [
        "precision",
        "backend",
        "quantizer",
        "bits",
        "quant_type",
        "group_size",
        "compute_dtype",
        "double_quant",
        "sym",
        "desc_act",
        "axis"
      ],
      "properties": {
        "precision": {"type": "string", "minLength": 1},
        "backend": {"type": "string", "minLength": 1},
        "quantizer": {"type": ["string", "null"]},
        "bits": {"type": ["integer", "null"], "minimum": 1},
        "quant_type": {"type": ["string", "null"]},
        "group_size": {"type": ["integer", "null"], "minimum": 1},
        "compute_dtype": {"type": ["string", "null"]},
        "double_quant": {"type": ["boolean", "null"]},
        "sym": {"type": ["boolean", "null"]},
        "desc_act": {"type": ["boolean", "null"]},
        "axis": {"type": ["integer", "string", "null"]}
      }
    },
    "observed_state": {
      "type": "object",
      "required": [
        "precision",
        "backend",
        "loader_mode",
        "quantization_verified"
      ],
      "properties": {
        "precision": {"type": "string", "minLength": 1},
        "backend": {"type": "string", "minLength": 1},
        "loader_mode": {"type": "string", "minLength": 1},
        "quantization_verified": {"type": "boolean"}
      }
    },
    "resolved_identity": {
      "type": "object",
      "required": [
        "source_checkpoint",
        "source_checkpoint_realpath",
        "source_checkpoint_manifest",
        "source_checkpoint_manifest_hash",
        "config_hash",
        "tokenizer_hash",
        "generation_config_hash",
        "source_run_id",
        "training_stage",
        "revision",
        "revision_status"
      ],
      "properties": {
        "source_checkpoint": {"type": "string"},
        "source_checkpoint_realpath": {"type": "string"},
        "source_checkpoint_manifest": {"type": "string"},
        "source_checkpoint_manifest_hash": {"type": "string"},
        "config_hash": {"type": "string"},
        "tokenizer_hash": {"type": "string"},
        "generation_config_hash": {"type": "string"},
        "source_run_id": {"type": "string", "minLength": 1},
        "training_stage": {"type": "string", "minLength": 1},
        "revision": {"type": ["string", "null"]},
        "revision_status": {
          "enum": ["recorded", "unavailable_local_checkpoint"]
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "python_version",
        "torch_version",
        "transformers_version",
        "backend_versions",
        "cuda_available",
        "cuda_version",
        "gpu_devices",
        "loader_mode",
        "fallback_used",
        "device_map"
      ],
      "properties": {
        "python_version": {"type": "string"},
        "torch_version": {"type": "string"},
        "transformers_version": {"type": "string"},
        "backend_versions": {"type": "object"},
        "cuda_available": {"type": "boolean"},
        "cuda_version": {"type": "string"},
        "gpu_devices": {"type": "array", "items": {"type": "string"}},
        "loader_mode": {"type": "string", "minLength": 1},
        "fallback_used": {"type": "boolean"},
        "device_map": {"type": "object"},
        "device_map_source": {
          "enum": ["model.hf_device_map", "loader_argument", "missing"]
        }
      }
    },
    "parameters": {
      "type": "object",
      "required": [
        "total_parameter_count",
        "trainable_parameter_count",
        "parameter_dtype_histogram",
        "buffer_dtype_histogram",
        "parameter_dtype_tensor_histogram",
        "buffer_dtype_tensor_histogram",
        "parameter_device_histogram",
        "buffer_device_histogram"
      ],
      "properties": {
        "total_parameter_count": {"type": "integer", "minimum": 0},
        "trainable_parameter_count": {"type": "integer", "minimum": 0},
        "parameter_dtype_histogram": {"type": "object"},
        "buffer_dtype_histogram": {"type": "object"},
        "parameter_dtype_tensor_histogram": {"type": "object"},
        "buffer_dtype_tensor_histogram": {"type": "object"},
        "parameter_device_histogram": {"type": "object"},
        "buffer_device_histogram": {"type": "object"}
      }
    },
    "buffers": {
      "type": "object",
      "required": [
        "total_buffers",
        "total_buffer_numel",
        "dtype_histogram_by_count",
        "dtype_histogram_by_numel",
        "device_histogram_by_count",
        "device_histogram_by_numel"
      ],
      "properties": {
        "total_buffers": {"type": "integer", "minimum": 0},
        "total_buffer_numel": {"type": "integer", "minimum": 0},
        "dtype_histogram_by_count": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "dtype_histogram_by_numel": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "device_histogram_by_count": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "device_histogram_by_numel": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      },
      "additionalProperties": false
    },
    "devices": {
      "type": "object",
      "required": [
        "hf_device_map",
        "normalized_hf_device_map",
        "parameter_device_histogram",
        "buffer_device_histogram",
        "quantized_module_device_histogram",
        "cpu_offload_detected",
        "disk_offload_detected",
        "cpu_parameter_numel",
        "cpu_parameter_fraction"
      ],
      "properties": {
        "hf_device_map": {"type": "object"},
        "normalized_hf_device_map": {"type": "object"},
        "device_map_source": {
          "enum": ["model.hf_device_map", "loader_argument", "missing"]
        },
        "parameter_device_histogram": {"type": "object"},
        "buffer_device_histogram": {"type": "object"},
        "quantized_module_device_histogram": {"type": "object"},
        "cpu_offload_detected": {"type": "boolean"},
        "disk_offload_detected": {"type": "boolean"},
        "cpu_parameter_numel": {"type": "integer", "minimum": 0},
        "cpu_parameter_fraction": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "modules": {
      "type": "object",
      "required": [
        "module_class_histogram",
        "expected_projection_count",
        "quantized_projection_count",
        "quantized_projection_coverage",
        "projection_details",
        "unquantized_expected_projections",
        "unexpected_quantized_modules",
        "excluded_modules"
      ],
      "properties": {
        "module_class_histogram": {"type": "object"},
        "expected_projection_count": {"type": "integer", "minimum": 0},
        "quantized_projection_count": {"type": "integer", "minimum": 0},
        "quantized_projection_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "projection_details": {"type": "array"},
        "unquantized_expected_projections": {
          "type": "array",
          "items": {"type": "string"}
        },
        "unexpected_quantized_modules": {
          "type": "array",
          "items": {"type": "string"}
        },
        "excluded_modules": {"type": "array", "items": {"type": "string"}}
      }
    },
    "bf16_policy": {
      "type": "object",
      "required": [
        "allowed_fp32_module_patterns",
        "max_unapproved_fp32_parameter_fraction",
        "max_total_fp32_parameter_fraction",
        "require_embedding_bf16",
        "require_lm_head_bf16"
      ],
      "properties": {
        "allowed_fp32_module_patterns": {
          "type": "array",
          "items": {"type": "string"}
        },
        "max_unapproved_fp32_parameter_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_total_fp32_parameter_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "require_embedding_bf16": {"type": "boolean"},
        "require_lm_head_bf16": {"type": "boolean"}
      }
    },
    "bf16_observation": {
      "type": "object",
      "required": [
        "total_parameter_numel",
        "bf16_parameter_numel",
        "fp32_parameter_tensor_count",
        "fp32_parameter_numel",
        "fp32_parameter_fraction",
        "approved_fp32_parameter_numel",
        "unapproved_fp32_parameter_numel",
        "unapproved_fp32_parameter_fraction",
        "approved_fp32_parameter_paths",
        "unapproved_fp32_parameter_paths",
        "fp32_embedding_parameter_paths",
        "fp32_lm_head_parameter_paths"
      ],
      "properties": {
        "total_parameter_numel": {"type": "integer", "minimum": 0},
        "bf16_parameter_numel": {"type": "integer", "minimum": 0},
        "fp32_parameter_tensor_count": {"type": "integer", "minimum": 0},
        "fp32_parameter_numel": {"type": "integer", "minimum": 0},
        "fp32_parameter_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "approved_fp32_parameter_numel": {"type": "integer", "minimum": 0},
        "unapproved_fp32_parameter_numel": {"type": "integer", "minimum": 0},
        "unapproved_fp32_parameter_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "approved_fp32_parameter_paths": {
          "type": "array",
          "items": {"type": "string"}
        },
        "unapproved_fp32_parameter_paths": {
          "type": "array",
          "items": {"type": "string"}
        },
        "fp32_embedding_parameter_paths": {
          "type": "array",
          "items": {"type": "string"}
        },
        "fp32_lm_head_parameter_paths": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "quantization": {
      "type": "object",
      "required": [
        "detected",
        "detected_backend",
        "detected_bits",
        "detected_quant_types",
        "detected_module_classes",
        "config_match",
        "requested_backend",
        "observed_backend",
        "requested_bits",
        "observed_bits",
        "requested_quant_type",
        "observed_quant_type",
        "backend_config",
        "fallback_detected"
      ],
      "properties": {
        "detected": {"type": "boolean"},
        "detected_backend": {"type": "string"},
        "detected_bits": {"type": ["integer", "string", "null"]},
        "detected_quant_types": {"type": "array", "items": {"type": "string"}},
        "detected_module_classes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "config_match": {"type": "boolean"},
        "requested_backend": {"type": "string", "minLength": 1},
        "observed_backend": {"type": "string"},
        "requested_bits": {"type": ["integer", "null"], "minimum": 1},
        "observed_bits": {"type": ["integer", "string", "null"]},
        "requested_quant_type": {"type": ["string", "null"]},
        "observed_quant_type": {"type": ["string", "null"]},
        "backend_config": {"type": "object"},
        "fallback_detected": {"type": "boolean"}
      }
    },
    "attestation": {
      "type": "object",
      "required": [
        "passed",
        "status",
        "policy_id",
        "blocking_reasons",
        "warnings"
      ],
      "properties": {
        "passed": {"type": "boolean"},
        "status": {
          "enum": [
            "ATTESTED_BF16",
            "ATTESTED_BNB_INT8",
            "ATTESTED_BNB_NF4",
            "ATTESTED_BNB_FP4",
            "ATTESTED_GPTQ",
            "ATTESTED_HQQ",
            "ATTESTED_GGUF",
            "IDENTITY_UNVERIFIED",
            "CHECKPOINT_MANIFEST_MISMATCH",
            "CONFIG_IDENTITY_MISMATCH",
            "TOKENIZER_IDENTITY_MISMATCH",
            "GENERATION_CONFIG_IDENTITY_MISMATCH",
            "SOURCE_RUN_ID_MISMATCH",
            "TRAINING_STAGE_MISMATCH",
            "CHECKPOINT_PATH_MISMATCH",
            "LOADED_CHECKPOINT_IDENTITY_UNVERIFIED",
            "LOADER_FAILED",
            "LOADER_FALLBACK_USED",
            "BACKEND_MISMATCH",
            "QUANTIZATION_NOT_DETECTED",
            "QUANTIZATION_COVERAGE_BELOW_THRESHOLD",
            "QUANT_CONFIG_MISMATCH",
            "QUANT_TYPE_UNVERIFIED",
            "DEVICE_MAP_UNVERIFIED",
            "UNSUPPORTED_ARCHITECTURE_FOR_ATTESTATION",
            "GGUF_METADATA_MISMATCH",
            "RUNTIME_HEALTHCHECK_FAILED",
            "CACHE_IDENTITY_UNVERIFIED",
            "CACHE_IDENTITY_MISMATCH",
            "GGUF_CACHE_IDENTITY_UNVERIFIED",
            "GGUF_CACHE_IDENTITY_MISMATCH",
            "DIAGNOSTIC_FALLBACK_NOT_ELIGIBLE",
            "BF16_DTYPE_COVERAGE_BELOW_THRESHOLD",
            "BF16_FP32_POLICY_VIOLATION"
          ]
        },
        "policy_id": {"type": "string", "minLength": 1},
        "blocking_reasons": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
